{
    "name": "sp-dashboard",
    "version": "1.0.0",
    "description": "A basic dashboard solution for SharePoint 2013/Online.",
    "main": "src/index.ts",
    "scripts": {
        "all": "node ./clean.js && npm run build && npm run prod && npm run spfx",
        "build": "webpack --mode=development",
        "prod": "webpack --mode=production",
        "spfx": "cd spfx && npm run package",
        "typings": "dts-bundle --configJson dts-bundle.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gunjandatta/sp-dashboard.git"
    },
    "keywords": [],
    "author": "Gunjan Datta",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/gunjandatta/sp-dashboard/issues"
    },
    "homepage": "https://github.com/gunjandatta/sp-dashboard#readme",
    "dependencies": {
        "datatables.net": "^3.1.2",
        "datatables.net-bs5": "^3.1.2",
        "dattatable": "^2.11.90",
        "gd-sprest-bs": "^10.15.94",
        "moment": "^2.31.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "babel-loader": "^9.2.1",
        "css-loader": "^7.1.2",
        "html-loader": "^5.1.0",
        "sass": "^1.105.0",
        "sass-loader": "^14.2.1",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "url-loader": "^4.1.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^5.1.4"
    }
}